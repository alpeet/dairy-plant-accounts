# Local data store written by dev-server.js — never commit plant data
data/

# Build output
dist/

# Local dependencies (the app itself has zero runtime dependencies)
node_modules/

# electron-builder writes this while "installing production dependencies" (there are
# none, so it only describes the build toolchain). Remove this line if you ever run
# `npm install` yourself and want to commit a lock file you actually generated.
package-lock.json
