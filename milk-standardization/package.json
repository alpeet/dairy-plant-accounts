{
  "name": "milk-standardization",
  "productName": "Milk Standardization Calculator",
  "version": "1.0.0",
  "description": "Offline milk fat/SNF standardization calculator — mass-balance methods for cream separation, cream addition, skim milk addition, water dilution and SMP reconstitution.",
  "main": "main.js",
  "author": "Prarambha",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node dev-server.js",
    "test": "node --test tests/calc.test.js",
    "check": "node --check main.js && node --check preload.js && node --check dev-server.js && node --check shared/calc.js && node --check shared/defaults.js && node --check shared/store.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "dairy",
    "milk",
    "standardization",
    "fat",
    "snf",
    "offline",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.prarambha.milkstandardization",
    "productName": "Milk Standardization Calculator",
    "copyright": "Copyright © $(year) Prarambha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "publish": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Milk-Standardization-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Milk-Standardization-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Milk Standardization",
      "runAfterFinish": true,
      "menuCategory": false,
      "unicode": true,
      "warningsAsErrors": false,
      "differentialPackage": false,
      "language": "1033"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Milk-Standardization-${version}-${arch}.${ext}",
      "category": "public.app-category.business",
      "darkModeSupport": false,
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "notarize": false,
      "minimumSystemVersion": "10.15"
    },
    "dmg": {
      "title": "Milk Standardization Calculator ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 620,
        "height": 460
      },
      "backgroundColor": "#0f5132",
      "internetEnabled": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "Milk-Standardization-${version}-${arch}.${ext}"
    }
  }
}
