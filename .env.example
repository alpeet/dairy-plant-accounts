[TEMPLATE]
# Prarambha Account & Stock Management — Environment Configuration
# ================================================
# Copy this file to .env and customize as needed.
#   cp .env.example .env
#
# The app works with default values if .env is not present.
# ================================================

# ── Server ──
# Port to listen on (default: 3000)
PORT=3000

# Host to bind to (default: 0.0.0.0 — all interfaces)
# Set to 127.0.0.1 for local-only access
HOST=0.0.0.0

# ── Authentication ──
# Default admin username (default: admin)
AUTH_USERNAME=admin

# ⚠️  IMPORTANT: Set a strong password in production (min 8 characters).
# There is NO built-in default password. If AUTH_PASSWORD is not set, the
# server creates NO default account — the first account is created through
# normal registration (open only while the database has no non-admin users).
# For Render: set this in Dashboard → Environment (never in blueprint)
# AUTH_PASSWORD=your-strong-password-here

# ── Database ──
# Directory to store the SQLite database file (default: ./data)
# On Render: set to the persistent disk mount path
DB_DIR=./data

# ── Application ──
# Node environment (development / production)
NODE_ENV=development